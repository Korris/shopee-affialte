# ===== Shopee Affiliate Open API =====
# Lấy tại https://affiliate.shopee.vn -> Công cụ -> API (cần tài khoản affiliate được duyệt)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Fallback khi chưa có API credentials: dùng affiliate id để build link redirect thủ công
SHOPEE_AFFILIATE_ID=

# ===== MongoDB (lưu lịch sử link, optional — app vẫn chạy nếu DB offline) =====
MONGODB_URI=mongodb://admin:conchohacker@localhost:27017/shopee-affiliate?authSource=admin
MONGODB_NAME=shopee-affiliate
